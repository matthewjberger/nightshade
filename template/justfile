set windows-shell := ["powershell.exe"]
export CARGO_INCREMENTAL := "0"
export RUST_LOG := "info,wgpu_core=off"
export RUST_BACKTRACE := "1"

@just:
    just --list

build:
    cargo build -r

check:
    cargo check --all --tests
    cargo fmt --all -- --check

docs:
    cargo doc --open

fix:
    cargo clippy --all --tests --fix

format:
    cargo fmt --all

init-wasm:
    rustup target add wasm32-unknown-unknown
    cargo install --locked trunk

lint:
    cargo clippy --all --tests -- -D warnings

run:
    cargo run -r

run-vr:
    cargo run -r --features vr

build-wasm:
    trunk build --release

run-wasm:
    trunk serve --release --open

test:
    cargo test --all -- --nocapture

udeps:
    cargo machete

licenses:
    cargo license

licenses-check:
    cargo deny check licenses

licenses-html:
    cargo about generate about.hbs -o THIRD_PARTY_LICENSES.html

vendor:
    cargo vendor

install-tools:
    cargo install --locked cargo-license
    cargo install --locked cargo-about
    cargo install --locked cargo-deny
    cargo install --locked cargo-machete

@versions:
    rustc --version
    cargo fmt -- --version
    cargo clippy -- --version

watch:
    cargo watch -x 'run -r'

init-android:
    rustup target add aarch64-linux-android
    cargo install --git https://github.com/rust-mobile/xbuild --bin x --locked
    x doctor

[windows]
build-android:
    $ErrorActionPreference = 'Stop'; $s = if ($env:ANDROID_NDK_SYSROOT) { $env:ANDROID_NDK_SYSROOT } elseif ($env:ANDROID_NDK_ROOT) { Join-Path $env:ANDROID_NDK_ROOT 'toolchains\llvm\prebuilt\windows-x86_64\sysroot' } else { Join-Path $env:LOCALAPPDATA 'x\Android.ndk' }; if (-not (Test-Path $s)) { throw "no android sysroot at $s, run 'just init-android'" }; $env:CC_aarch64_linux_android = 'clang'; $env:CXX_aarch64_linux_android = 'clang++'; $env:AR_aarch64_linux_android = 'llvm-ar'; $env:CFLAGS_aarch64_linux_android = "--sysroot=$s"; $env:CXXFLAGS_aarch64_linux_android = "--sysroot=$s"; x build --release --platform android --arch arm64

[unix]
build-android:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "${ANDROID_NDK_SYSROOT:-}" ]; then sysroot="${ANDROID_NDK_SYSROOT}"
    elif [ -n "${ANDROID_NDK_ROOT:-}" ]; then sysroot="${ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt/$(uname | tr '[:upper:]' '[:lower:]')-x86_64/sysroot"
    else sysroot="${XDG_CACHE_HOME:-$HOME/.cache}/x/Android.ndk"; fi
    [ -d "${sysroot}" ] || { echo "no android sysroot at ${sysroot}, run 'just init-android'"; exit 1; }
    CC_aarch64_linux_android=clang \
    CXX_aarch64_linux_android=clang++ \
    AR_aarch64_linux_android=llvm-ar \
    CFLAGS_aarch64_linux_android="--sysroot=${sysroot}" \
    CXXFLAGS_aarch64_linux_android="--sysroot=${sysroot}" \
    x build --release --platform android --arch arm64

install-android:
    adb install -r target/x/release/android/template.apk

run-android:
    just build-android
    just install-android
    adb shell monkey -p com.nightshade.template -c android.intent.category.LAUNCHER 1

logcat-android tag="Template":
    adb logcat -s {{tag}}

list-android:
    adb devices

init-steamdeck:
    cargo install cross --git https://github.com/cross-rs/cross --rev 29d00c7 --locked

build-steamdeck:
    cross build --release --target x86_64-unknown-linux-gnu

deploy-steamdeck:
    just build-steamdeck
    scp ./target/x86_64-unknown-linux-gnu/release/template deck@steamdeck.local:~/Downloads

deploy-steamdeck-quick:
    just build-steamdeck
    scp ./target/x86_64-unknown-linux-gnu/release/template deck@steamdeck.local:~/Downloads/app
    ssh deck@steamdeck.local "chmod +x ~/Downloads/app"
