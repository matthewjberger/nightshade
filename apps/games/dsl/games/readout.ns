-- One line of text across the bottom of the view. A description carries
-- Readout on nothing of its own and writes Label on what this spawned.

module readout

shows Readout, Sign

component Readout

config Sign
   anchor = (0.5, 0.08)
   size number = 22
   color = (0.9, 0.94, 1.0)

system readout.raise
   once
   in Sign
   creates entities

   spawn Label "", Anchor Sign.anchor, Size Sign.size, Color Sign.color, Readout 1
