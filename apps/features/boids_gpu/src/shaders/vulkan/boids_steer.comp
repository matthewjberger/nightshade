#version 460
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;

#include "boids_common.glsl"

struct Neighborhood {
    vec3 pushed;
    vec3 heading;
    vec3 middle;
    float found;
};

Neighborhood survey(uint index, vec3 position) {
    Neighborhood found;
    found.pushed = vec3(0.0);
    found.heading = vec3(0.0);
    found.middle = vec3(0.0);
    found.found = 0.0;

    int dimension = int(uniforms.counts.y);
    uint capacity = uniforms.counts.w;
    float radius_squared = uniforms.search.y;

    int base_x = int(cell_axis(position.x));
    int base_y = int(cell_axis(position.y));
    int base_z = int(cell_axis(position.z));

    for (int offset_z = -1; offset_z <= 1; offset_z++) {
        int z = base_z + offset_z;
        if (z < 0 || z >= dimension) { continue; }
        for (int offset_y = -1; offset_y <= 1; offset_y++) {
            int y = base_y + offset_y;
            if (y < 0 || y >= dimension) { continue; }
            for (int offset_x = -1; offset_x <= 1; offset_x++) {
                int x = base_x + offset_x;
                if (x < 0 || x >= dimension) { continue; }

                uint cell = (uint(z) * uint(dimension) + uint(y)) * uint(dimension) + uint(x);
                uint held = min(cell_counts[cell], capacity);
                for (uint slot = 0u; slot < held; slot++) {
                    uint other = cell_items[cell * capacity + slot];
                    if (other == index) { continue; }

                    vec3 offset = positions_in[other].xyz - position;
                    float distance_squared = dot(offset, offset);
                    if (distance_squared >= radius_squared || distance_squared <= 0.0) {
                        continue;
                    }

                    found.pushed -= offset / distance_squared;
                    found.heading += velocities_in[other].xyz;
                    found.middle += positions_in[other].xyz;
                    found.found += 1.0;
                }
            }
        }
    }

    return found;
}

vec3 turn_from_walls(vec3 position) {
    float bounds = uniforms.step_values.y;
    float strength = uniforms.weights.w;
    vec3 past = abs(position) - bounds;
    vec3 pull = -sign(position) * max(past, vec3(0.0));
    return pull * strength;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uniforms.counts.x) {
        return;
    }

    vec3 position = positions_in[index].xyz;
    vec3 velocity = velocities_in[index].xyz;

    Neighborhood found = survey(index, position);
    if (found.found > 0.0) {
        vec3 middle = found.middle / found.found;
        vec3 heading = found.heading / found.found;
        velocity += found.pushed * uniforms.weights.x;
        velocity += (heading - velocity) * uniforms.weights.y;
        velocity += (middle - position) * uniforms.weights.z;
    }

    velocity += turn_from_walls(position);

    float max_speed = uniforms.step_values.w;
    float speed = length(velocity);
    if (speed > max_speed) {
        velocity = velocity * (max_speed / speed);
    } else if (speed < max_speed * 0.35 && speed > 0.0) {
        velocity = velocity * (max_speed * 0.35 / speed);
    }

    positions_out[index] = vec4(position + velocity * uniforms.step_values.x, 1.0);
    velocities_out[index] = vec4(velocity, 0.0);
}
