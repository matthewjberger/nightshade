#version 460
#extension GL_GOOGLE_include_directive : require

#define PROBE_WRITE

#include "scene_common.glsl"
#include "scene_probes.glsl"

layout(
    local_size_x = PROBE_IRRADIANCE_TILE,
    local_size_y = PROBE_IRRADIANCE_TILE,
    local_size_z = 1
) in;

layout(push_constant) uniform Push {
    uvec2 counts;
} push;

shared vec3 gathered[PROBE_IRRADIANCE_TILE * PROBE_IRRADIANCE_TILE];

void main() {
    uint probe = gl_WorkGroupID.x;
    if (probe >= push.counts.y) {
        return;
    }
    ivec2 tile = ivec2(gl_LocalInvocationID.xy);
    uint seat = gl_LocalInvocationIndex;
    bool inside = tile.x >= PROBE_BORDER
        && tile.y >= PROBE_BORDER
        && tile.x <= PROBE_IRRADIANCE_TEXELS
        && tile.y <= PROBE_IRRADIANCE_TEXELS;

    if (inside) {
        ivec2 interior = tile - ivec2(PROBE_BORDER);
        vec3 direction = octahedral_decode(
            probe_texel_point(interior, PROBE_IRRADIANCE_TEXELS)
        );
        vec3 sum = vec3(0.0);
        float total = 0.0;
        for (uint ray = 0u; ray < uint(PROBE_RAYS); ++ray) {
            uint slot = probe_ray_slot(probe, ray);
            vec4 answer = probe_rays[slot];
            if (answer.w < 0.0) {
                continue;
            }
            float weight = max(dot(direction, probe_rays[slot + 1u].xyz), 0.0);
            if (weight <= 0.0) {
                continue;
            }
            sum += answer.rgb * weight;
            total += weight;
        }
        gathered[seat] = total > 1.0e-6 ? sqrt(max(sum / total, vec3(0.0))) : vec3(0.0);
    }

    barrier();

    ivec2 origin = probe_tile_origin(probe_coords_of(probe), PROBE_IRRADIANCE_TILE);
    if (inside) {
        vec3 found = gathered[seat];
        vec3 had = imageLoad(probe_irradiance_store, origin + tile).rgb;
        float keep = push.counts.x == 0u ? 0.0 : clamp(frame.probe_settings.x, 0.0, 0.99);
        imageStore(probe_irradiance_store, origin + tile, vec4(mix(found, had, keep), 1.0));
        return;
    }

    ivec2 source = probe_border_source(tile, PROBE_IRRADIANCE_TEXELS);
    vec3 carried = gathered[uint(source.y) * uint(PROBE_IRRADIANCE_TILE) + uint(source.x)];
    vec3 had = imageLoad(probe_irradiance_store, origin + tile).rgb;
    float keep = push.counts.x == 0u ? 0.0 : clamp(frame.probe_settings.x, 0.0, 0.99);
    imageStore(probe_irradiance_store, origin + tile, vec4(mix(carried, had, keep), 1.0));
}
