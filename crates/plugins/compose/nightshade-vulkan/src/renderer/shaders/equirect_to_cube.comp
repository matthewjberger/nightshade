#version 460
#extension GL_GOOGLE_include_directive : require

#include "environment_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D equirectangular;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray faces;

layout(push_constant) uniform Params {
    uint size;
} params;

vec2 equirectangular_uv(vec3 direction) {
    float longitude = atan(direction.z, direction.x);
    float latitude = asin(clamp(direction.y, -1.0, 1.0));
    return vec2(longitude / (2.0 * PI) + 0.5, 0.5 - latitude / PI);
}

void main() {
    uvec2 coords = gl_GlobalInvocationID.xy;
    uint face = gl_GlobalInvocationID.z;
    if (coords.x >= params.size || coords.y >= params.size || face >= 6u) {
        return;
    }
    vec2 uv = (vec2(coords) + 0.5) / float(params.size);
    vec3 direction = cube_direction(face, uv);
    vec4 color = textureLod(equirectangular, equirectangular_uv(direction), 0.0);
    color.rgb = clamp(color.rgb, vec3(0.0), vec3(65000.0));
    imageStore(faces, ivec3(ivec2(coords), int(face)), color);
}
