#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D destination;

layout(push_constant) uniform Push {
    uvec2 destination_size;
    uvec2 source_size;
} push;

void main() {
    uvec2 at = gl_GlobalInvocationID.xy;
    if (at.x >= push.destination_size.x || at.y >= push.destination_size.y) {
        return;
    }
    vec2 texel = 1.0 / vec2(max(push.source_size, uvec2(1u)));
    vec2 center = (vec2(at) + 0.5) / vec2(push.destination_size);
    vec4 gathered =
        texture(source, center + vec2(-0.5, -0.5) * texel)
        + texture(source, center + vec2(0.5, -0.5) * texel)
        + texture(source, center + vec2(-0.5, 0.5) * texel)
        + texture(source, center + vec2(0.5, 0.5) * texel);
    imageStore(destination, ivec2(at), gathered * 0.25);
}
