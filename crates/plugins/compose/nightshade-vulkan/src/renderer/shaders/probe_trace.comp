#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_ray_query : require

#define PROBE_WRITE

#include "scene_common.glsl"
#include "scene_rays.glsl"
#include "scene_traced.glsl"
#include "scene_probes.glsl"

layout(local_size_x = PROBE_RAYS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Push {
    uvec2 counts;
} push;

void main() {
    uint probe = gl_WorkGroupID.x;
    if (probe >= push.counts.y) {
        return;
    }
    uint ray = gl_LocalInvocationID.x;
    ivec3 coords = probe_coords_of(probe);
    vec3 from = probe_position(coords);
    vec3 direction = probe_ray_of(ray);
    float reach = max(frame.probe_spacing.w, 0.01);
    float step_off = max(reach * 1.0e-4, 1.0e-5);

    vec3 met_light = vec3(0.0);
    float travelled = reach;

    Met met;
    if (trace(from, direction, step_off, reach, met)) {
        bool from_behind;
        Surface stood = surface_at_seen(met, direction, from_behind);
        travelled = met.travelled;
        if (from_behind) {
            travelled = -travelled * 0.2;
        } else {
            vec3 at = from + direction * met.travelled;
            met_light = shade(stood, at, direction, reach);
            float bounce = frame.probe_settings.y;
            if (bounce > 0.0) {
                vec3 body = stood.albedo * (1.0 - stood.metallic);
                met_light += body * probe_arriving_light(at, stood.normal, -direction) * bounce;
            }
        }
    } else {
        met_light = arriving_light(direction);
    }

    uint slot = probe_ray_slot(probe, ray);
    probe_rays[slot] = vec4(min(met_light, vec3(16.0)), travelled);
    probe_rays[slot + 1u] = vec4(direction, 0.0);
}
