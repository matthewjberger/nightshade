set windows-shell := ["powershell.exe"]
export RUST_BACKTRACE := "1"

@just:
    just --list

build:
    cargo build -p nightshade-ecs --all-features --examples

test:
    cargo test -p nightshade-ecs --all-features

lint:
    cargo clippy -p nightshade-ecs --all-targets --all-features -- -D warnings

format:
    cargo fmt -p nightshade-ecs

doc:
    cargo doc -p nightshade-ecs --no-deps --all-features

[windows]
list:
    @Get-ChildItem examples -Filter *.rs | ForEach-Object { $_.BaseName }

[unix]
list:
    @ls examples/*.rs | xargs -n1 basename | sed 's/\.rs$//'

run name:
    cargo run -p nightshade-ecs --example {{ name }}
